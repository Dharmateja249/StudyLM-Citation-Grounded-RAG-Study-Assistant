*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
studylm.db
local_storage/
uploads/
temp/
tmp/
*.tmp
*.temp
qdrant_storage/
vector_store/

