# =============================================================================
# Next.js Frontend .gitignore
# =============================================================================

# Dependencies
/node_modules
/.pnpm-store
/.npm
/.yarn

# Next.js Build Outputs
/.next/
/out/
/build
/dist
/.turbo
/.vercel

# Environment & Secret Files
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# TypeScript Build Info
*.tsbuildinfo
tsconfig.tsbuildinfo
next-env.d.ts.bak

# Testing & Coverage
/coverage
.eslintcache
.stylelintcache

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
