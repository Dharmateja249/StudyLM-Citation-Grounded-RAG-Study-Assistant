# =============================================================================
# FastAPI / Python Backend .gitignore
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# Environment & Secrets (Never commit secrets)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
client_secret*.json
service_account*.json
token.json
.secrets

# Testing, Coverage & Linters
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
pip-log.txt
pip-delete-this-directory.txt
pytestdebug.log

# Databases & local stores
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
studylm.db
local_storage/
uploads/
temp/
tmp/
*.tmp
*.temp
qdrant_storage/

# Logs & dumps
*.log
logs/
*.dump
*.prof
*.profraw
*.pid
*.pid.lock

# OS & Editor
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*.swn
*~
*.bak

# Temporary / Scratch & Debug Scripts
debug_*.py
test_debug_*.py
scratch/
*.scratch.*
