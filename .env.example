# ==============================================================================
# StudyLM Unified Environment Configuration Template
# Copy this file to .env and configure your secret credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend & Gateway Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. Application & Core Environment
# ------------------------------------------------------------------------------
PROJECT_NAME=StudyLM Backend
ENVIRONMENT=development
DEBUG=True

# ------------------------------------------------------------------------------
# 3. Security & Authentication Subsystem
# ------------------------------------------------------------------------------
SECRET_KEY=studylm-super-secret-dev-key-change-in-production-abcdef123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 4. Database (SQLite for Local Dev / PostgreSQL for Production)
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./studylm.db
PROCRASTINATE_DATABASE_URL=sqlite:///./studylm.db

# ------------------------------------------------------------------------------
# 5. Cloudflare R2 Object Storage
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=studylm-sources
R2_ENDPOINT_URL=
PRESIGNED_URL_EXPIRE_SECONDS=900

# ------------------------------------------------------------------------------
# 6. Qdrant Vector Database
# ------------------------------------------------------------------------------
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=studylm_chunks

# ------------------------------------------------------------------------------
# 7. Gemini AI Models & Embeddings
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
GEMINI_GENERATION_MODEL=gemini-3.8-flash
RETRIEVAL_REFUSAL_THRESHOLD=0.40
SUMMARY_FULL_CONTEXT_TOKEN_LIMIT=80000

# ------------------------------------------------------------------------------
# 8. Quotas & Rate Limits (P0 Critical Constraints)
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE=52428800
SOURCE_QUOTA=20
RATE_LIMIT_QUERIES_PER_HOUR=60
RATE_LIMIT_WINDOW_SECONDS=3600

# ------------------------------------------------------------------------------
# 9. Worker & Maintenance Intervals
# ------------------------------------------------------------------------------
WORKER_UPDATE_HEARTBEAT_INTERVAL=10.0
WORKER_STALLED_TIMEOUT=30.0
WORKER_POLLING_INTERVAL=15.0
SWEEPER_DEADLINE_HOURS=4
REAPER_GRACE_PERIOD_SECONDS=7200
ORPHAN_R2_RECONCILER_AGE_SECONDS=3600
